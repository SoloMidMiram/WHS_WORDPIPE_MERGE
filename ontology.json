{
  "meta": {
    "title": "WHS WordPipe Merge Ontology",
    "version": "1.0.0",
    "date_gregorian": "2026-02-14",
    "date_jalali": "1404-11-25",
    "description": "Formal entity-relationship model for the WHS WordPipe Merge project"
  },
  "classes": [
    {
      "id": "entity",
      "name": "Entity",
      "abstract": true,
      "description": "Base class for all ontology entities"
    },
    {
      "id": "artifact",
      "name": "Artifact",
      "parent": "entity",
      "description": "Any persistent file or data output",
      "attributes": {
        "path": {
          "type": "Path",
          "description": "Location in repo"
        },
        "kind": {
          "type": "Enum",
          "values": [
            "source",
            "doc",
            "evidence",
            "config"
          ],
          "description": "Type of artifact"
        },
        "sha256": {
          "type": "String",
          "description": "Content hash for dedup"
        },
        "git_created": {
          "type": "Date",
          "description": "First commit date"
        },
        "git_modified": {
          "type": "Date",
          "description": "Last commit date"
        },
        "fs_mtime": {
          "type": "Date",
          "description": "Filesystem modification time"
        }
      },
      "subtypes": [
        "doc",
        "source_file",
        "evidence",
        "config_file"
      ]
    },
    {
      "id": "doc",
      "name": "Doc",
      "parent": "artifact",
      "description": "Markdown documentation file"
    },
    {
      "id": "source_file",
      "name": "SourceFile",
      "parent": "artifact",
      "description": "Python source code file"
    },
    {
      "id": "evidence",
      "name": "Evidence",
      "parent": "artifact",
      "description": "Pipeline output (logs, manifests, reports)"
    },
    {
      "id": "config_file",
      "name": "ConfigFile",
      "parent": "artifact",
      "description": "Configuration file (.toml, .gitignore, .env.example)"
    },
    {
      "id": "duplicate_set",
      "name": "DuplicateSet",
      "parent": "entity",
      "description": "Group of files sharing the same name or content",
      "attributes": {
        "canonical_path": {
          "type": "Path",
          "description": "The authoritative version"
        },
        "duplicate_type": {
          "type": "Enum",
          "values": [
            "mirror",
            "wrapper",
            "version_history"
          ],
          "description": "Type of duplication"
        },
        "content_match": {
          "type": "Boolean",
          "description": "Whether all copies have same SHA256"
        }
      },
      "subtypes": [
        "mirror_pair",
        "compatibility_wrapper",
        "version_history"
      ]
    },
    {
      "id": "mirror_pair",
      "name": "MirrorPair",
      "parent": "duplicate_set",
      "description": "Active <-> Snapshot copy (archival)",
      "attributes": {
        "active_path": {
          "type": "Path",
          "description": "The working copy"
        },
        "snapshot_path": {
          "type": "Path",
          "description": "The frozen archival copy"
        },
        "diverged": {
          "type": "Boolean",
          "description": "Whether active differs from snapshot"
        }
      }
    },
    {
      "id": "compatibility_wrapper",
      "name": "CompatibilityWrapper",
      "parent": "duplicate_set",
      "description": "Thin re-export for backward compatibility",
      "attributes": {
        "target_module": {
          "type": "Path",
          "description": "The module being re-exported"
        },
        "import_statement": {
          "type": "String",
          "description": "The import line"
        }
      }
    },
    {
      "id": "version_history",
      "name": "VersionHistory",
      "parent": "duplicate_set",
      "description": "Dated snapshots of same module (legacy)",
      "attributes": {
        "versions": {
          "type": "List[Path]",
          "description": "Ordered list of dated snapshots"
        },
        "earliest": {
          "type": "Date",
          "description": "Oldest snapshot date"
        },
        "latest": {
          "type": "Date",
          "description": "Most recent snapshot date"
        }
      }
    },
    {
      "id": "activity_period",
      "name": "ActivityPeriod",
      "parent": "entity",
      "description": "A bounded span of work with a goal",
      "attributes": {
        "name": {
          "type": "String",
          "description": "Short label"
        },
        "start_date": {
          "type": "Date",
          "description": "When it began"
        },
        "end_date": {
          "type": "Date",
          "description": "When it ended"
        },
        "goal": {
          "type": "String",
          "description": "What was to be achieved"
        }
      },
      "subtypes": [
        "phase",
        "session"
      ]
    },
    {
      "id": "phase",
      "name": "Phase",
      "parent": "activity_period",
      "description": "Named project phase"
    },
    {
      "id": "session",
      "name": "Session",
      "parent": "activity_period",
      "description": "Single work session (date-bound)"
    },
    {
      "id": "claim",
      "name": "Claim",
      "parent": "entity",
      "description": "A statement made in docs or code",
      "attributes": {
        "text": {
          "type": "String",
          "description": "The assertion"
        },
        "status": {
          "type": "Enum",
          "values": [
            "true",
            "false",
            "untested",
            "partial"
          ],
          "description": "Verification status"
        }
      },
      "subtypes": [
        "design_claim",
        "evidence_claim",
        "status_claim"
      ]
    },
    {
      "id": "design_claim",
      "name": "DesignClaim",
      "parent": "claim",
      "description": "X is designed to do Y"
    },
    {
      "id": "evidence_claim",
      "name": "EvidenceClaim",
      "parent": "claim",
      "description": "The pipeline produces Z"
    },
    {
      "id": "status_claim",
      "name": "StatusClaim",
      "parent": "claim",
      "description": "Feature is complete"
    },
    {
      "id": "verification",
      "name": "Verification",
      "parent": "entity",
      "description": "How a claim is checked",
      "attributes": {
        "method": {
          "type": "Enum",
          "values": [
            "test",
            "command",
            "inspection"
          ],
          "description": "Verification method"
        },
        "command_or_path": {
          "type": "String",
          "description": "The test command or file to inspect"
        }
      },
      "subtypes": [
        "test",
        "command",
        "inspection"
      ]
    },
    {
      "id": "test",
      "name": "Test",
      "parent": "verification",
      "description": "Automated test (unittest)"
    },
    {
      "id": "command",
      "name": "Command",
      "parent": "verification",
      "description": "CLI command to run"
    },
    {
      "id": "inspection",
      "name": "Inspection",
      "parent": "verification",
      "description": "Manual review"
    },
    {
      "id": "role",
      "name": "Role",
      "parent": "entity",
      "description": "Who interacts with the system",
      "subtypes": [
        "operator",
        "engineer",
        "architect"
      ]
    },
    {
      "id": "operator",
      "name": "Operator",
      "parent": "role",
      "description": "Runs and triages the pipeline"
    },
    {
      "id": "engineer",
      "name": "Engineer",
      "parent": "role",
      "description": "Modifies pipeline stages"
    },
    {
      "id": "architect",
      "name": "Architect",
      "parent": "role",
      "description": "Designs TraceLedger alignment"
    }
  ],
  "relations": [
    {
      "name": "produces",
      "domain": "activity_period",
      "range": "artifact",
      "description": "Work output"
    },
    {
      "name": "consumes",
      "domain": "activity_period",
      "range": "artifact",
      "description": "Work input"
    },
    {
      "name": "states",
      "domain": "artifact",
      "range": "claim",
      "description": "A doc or code makes a claim"
    },
    {
      "name": "verifies",
      "domain": "verification",
      "range": "claim",
      "description": "How a claim is checked"
    },
    {
      "name": "verified_by",
      "domain": "claim",
      "range": "verification",
      "description": "Inverse of verifies"
    },
    {
      "name": "depends_on",
      "domain": "artifact",
      "range": "artifact",
      "description": "Dependency between artifacts"
    },
    {
      "name": "part_of",
      "domain": "activity_period",
      "range": "activity_period",
      "description": "Hierarchical (Session -> Phase)"
    },
    {
      "name": "precedes",
      "domain": "activity_period",
      "range": "activity_period",
      "description": "Temporal ordering"
    },
    {
      "name": "is_duplicate_of",
      "domain": "artifact",
      "range": "artifact",
      "description": "Same name/content as another file"
    },
    {
      "name": "wraps",
      "domain": "compatibility_wrapper",
      "range": "artifact",
      "description": "Re-exports from target module"
    },
    {
      "name": "mirrors",
      "domain": "mirror_pair",
      "range": "artifact",
      "description": "Active <-> Snapshot correspondence"
    },
    {
      "name": "evolves_to",
      "domain": "version_history",
      "range": "version_history",
      "description": "Temporal ordering of versions"
    }
  ],
